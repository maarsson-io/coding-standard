name: CI

on:
  push:
  pull_request:

permissions:
  contents: read

env:
  APP_ENV: testing
  APP_KEY: 'base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA='
  APP_URL: http://localhost
  DB_CONNECTION: sqlite
  DB_DATABASE: ':memory:'
  CACHE_DRIVER: array
  CACHE_STORE: array
  MAIL_MAILER: array
  QUEUE_CONNECTION: sync
  SESSION_DRIVER: array
  TELESCOPE_ENABLED: false

jobs:
  tests:
    name: CI Tests
    runs-on: ubuntu-24.04
    timeout-minutes: 6

    steps:
      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Set up PHP
        uses: shivammathur/setup-php@f3e473d116dcccaddc5834248c87452386958240 # 2.37.2
        with:
          php-version: '8.4'
          extensions: sqlite3, pdo_sqlite, pcntl
          coverage: none
          tools: composer

      - name: Prepare environment
        run: cp .env.example .env

      - name: Validate Composer configuration
        run: composer validate --strict

      - name: Install Composer dependencies
        # Check the committed rulesets without overwriting them via coding-standard:sync.
        run: composer install --no-interaction --no-progress --prefer-dist --optimize-autoloader --no-scripts

      - name: Bootstrap Composer autoloading and Laravel packages
        run: composer run-script post-autoload-dump --no-interaction

      - name: Validate Composer autoloading
        run: vendor/bin/grumphp run --tasks=composer_validate_autoload

      - name: JSON Lint
        run: vendor/bin/grumphp run --tasks=jsonlint

      - name: XML Lint
        run: vendor/bin/grumphp run --tasks=xmllint

      - name: YAML Lint
        run: vendor/bin/grumphp run --tasks=yamllint

      - name: Debug Statement Check
        # GrumPHP runs git_blacklist only in the pre-commit context, so the script applies the task's configuration.
        run: vendor/bin/check-debug-statements.php

      - name: PHP CodeSniffer
        run: vendor/bin/phpcs --parallel=4 .

      - name: PHP CS Fixer
        run: vendor/bin/php-cs-fixer check --diff

      - name: PHP Mess Detector
        run: vendor/bin/phpmd analyze . --format ansi --ruleset phpmd.yml

      - name: PHPStan
        run: vendor/bin/phpstan analyse --no-progress --memory-limit=-1

      - name: Set up Node.js
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: '22.22.0'
          cache: npm
          cache-dependency-path: package-lock.json

      - name: Install frontend dependencies
        run: npm ci --prefer-offline --no-audit --no-fund

      - name: ESLint
        run: npm run eslint

      - name: Stylelint
        run: npm run stylelint

  php-matrix:
    name: CI Test PHP ${{ matrix.php }}
    strategy:
      fail-fast: false
      matrix:
        php: ['8.4', '8.5']
    runs-on: ubuntu-24.04
    timeout-minutes: 6

    steps:
      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Set up PHP
        uses: shivammathur/setup-php@f3e473d116dcccaddc5834248c87452386958240 # 2.37.2
        with:
          php-version: ${{ matrix.php }}
          extensions: sqlite3, pdo_sqlite, pcntl
          coverage: none
          tools: composer

      - name: Prepare environment
        run: cp .env.example .env

      - name: Validate Composer configuration
        run: composer validate --strict

      - name: Install Composer dependencies
        # Check the committed rulesets without overwriting them via coding-standard:sync.
        run: composer install --no-interaction --no-progress --prefer-dist --optimize-autoloader --no-scripts

      - name: Bootstrap Composer autoloading and Laravel packages
        run: composer run-script post-autoload-dump --no-interaction

      - name: PHP Lint
        run: vendor/bin/grumphp run --tasks=phplint

      - name: Laravel tests
        env:
          SHELL_VERBOSITY: 1
        run: >
          php artisan test
          --display-all-issues
          --fail-on-warning
          --fail-on-notice
          --fail-on-deprecation
          --fail-on-risky
          --fail-on-empty-test-suite
