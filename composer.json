{
    "name": "maarsson/coding-standard",
    "description": "Centralized custom coding standards applied across my projects",
    "type": "library",
    "keywords": [
        "qa",
        "dev",
        "standards"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "VMaarsson",
            "email": "viktor@maarsson.io"
        }
    ],
    "require": {
        "php": ">=8.4 <8.6",
        "friendsofphp/php-cs-fixer": "^3.95",
        "larastan/larastan": "^3.10",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpmd/phpmd": "^3.0",
        "phpro/grumphp": "^2.25",
        "shipmonk/dead-code-detector": "^1.4",
        "slevomat/coding-standard": "^8.31",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "require-dev": {
        "laravel/framework": "^13.0",
        "orchestra/testbench-core": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Maarsson\\CodingStandard\\": "src/"
        }
    },
    "scripts": {
        "ci:grumphp-consumer": [
            "@php test/ci/grumphp-consumer.php"
        ],
        "ci:dead-code-passes": [
            "sh test/ci/phpstan-fixtures.sh GoodCode dead-code"
        ],
        "ci:dead-code-fails": [
            "sh test/ci/phpstan-fixtures.sh BadCode dead-code"
        ],
        "ci:larastan-passes": [
            "sh test/ci/phpstan-fixtures.sh GoodCode"
        ],
        "ci:larastan-fails": [
            "sh test/ci/phpstan-fixtures.sh BadCode"
        ],
        "ci:phpmd-passes": [
            "./vendor/bin/phpmd analyze test/fixtures/Phpmd/GoodCode --format=ansi --ruleset=resources/phpmd.yml.dist --suffixes=php --cache --cache-file=.phpmd.cache"
        ],
        "ci:phpmd-fails": [
            "./vendor/bin/phpmd analyze test/fixtures/Phpmd/BadCode --format=ansi --ruleset=resources/phpmd.yml.dist --suffixes=php --cache --cache-file=.phpmd.cache"
        ],
        "ci:phpcs-passes": [
            "./vendor/bin/phpcs --standard=resources/phpcs.xml.dist --cache=.phpcs.cache test/fixtures/Phpcs/GoodCode"
        ],
        "ci:phpcs-fails": [
            "./vendor/bin/phpcs --standard=resources/phpcs.xml.dist --cache=.phpcs.cache test/fixtures/Phpcs/BadCode"
        ],
        "ci:phpcsfixer-passes": [
            "./vendor/bin/php-cs-fixer fix --dry-run --config=resources/php-cs-fixer.php.dist --cache-file=.php-cs-fixer.cache test/fixtures/PhpcsFixer/GoodCode"
        ],
        "ci:phpcsfixer-fails": [
            "./vendor/bin/php-cs-fixer fix --dry-run --config=resources/php-cs-fixer.php.dist --cache-file=.php-cs-fixer.cache test/fixtures/PhpcsFixer/BadCode"
        ],
        "ci:frontend-consumer": [
            "@php test/ci/frontend-consumer.php"
        ]
    },
    "bin": [
        "bin/check-debug-statements.php",
        "bin/sync-coding-standards.php"
    ],
    "extra": {
        "frontend-tools": {
            "@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
            "@eslint/js": "^10.0.1",
            "@stylistic/eslint-plugin": "^5.10.0",
            "@stylistic/stylelint-plugin": "^5.3.1",
            "eslint": "^10.12.0",
            "eslint-plugin-vue": "^10.11.1",
            "globals": "^17.13.0",
            "postcss-html": "^2.0.0",
            "stylelint": "^17.16.0",
            "stylelint-config-recommended-vue": "^2.0.0",
            "stylelint-config-standard": "^40.0.0",
            "stylelint-config-standard-scss": "^17.0.0",
            "stylelint-config-standard-vue": "^2.0.0",
            "typescript": "^6.0.3",
            "typescript-eslint": "^8.71.1"
        }
    },
    "config": {
        "sort-packages": true
    }
}
